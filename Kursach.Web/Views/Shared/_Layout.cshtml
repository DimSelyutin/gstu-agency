<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Кадровое агентство</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kursach.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Кадровое агентство</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Applicants" asp-action="Index">Соискатели</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Skills" asp-action="Index">Навыки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Industries" asp-action="Index">Сферы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Companies" asp-action="Index">Компании</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vacancies" asp-action="Index">Вакансии</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Interviews" asp-action="Index">Собеседования</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Отчёты
                            </a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-item-text text-muted small">Подбор — из карточки соискателя</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Vacancies" asp-action="OpenByIndustry">Открытые по сфере</a></li>
                                <li><a class="dropdown-item" asp-controller="Vacancies" asp-action="ClosedReport">Закрытые вакансии</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year — Кадровое агентство
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
