@model ApplicantEditViewModel
@{
    ViewData["Title"] = "Новый соискатель";
}

<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Education" class="form-label"></label>
        <select asp-for="Education" asp-items="Html.GetEnumSelectList<EducationLevel>()" class="form-select"></select>
        <span asp-validation-for="Education" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExperienceYears" class="form-label"></label>
        <input asp-for="ExperienceYears" class="form-control" />
        <span asp-validation-for="ExperienceYears" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DesiredSalary" class="form-label"></label>
        <input asp-for="DesiredSalary" class="form-control" />
        <span asp-validation-for="DesiredSalary" class="text-danger"></span>
    </div>

    <h2 class="h5">Навыки</h2>
    <p class="text-muted small">Отметьте навыки и укажите уровень (1–5).</p>
    @foreach (var skill in Model.AvailableSkills)
    {
        var existing = Model.Skills.FirstOrDefault(s => s.SkillId == skill.Id);
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="selectedSkillIds" value="@skill.Id" id="skill_@skill.Id" checked="@(existing != null)" />
            <label class="form-check-label" for="skill_@skill.Id">@skill.Name</label>
            <input type="number" class="form-control form-control-sm d-inline-block ms-2" style="width:4rem" name="level_@skill.Id" value="@(existing?.Level ?? 3)" min="1" max="5" />
        </div>
    }

    <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
