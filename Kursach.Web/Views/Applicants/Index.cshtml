@model PagedListViewModel<Applicant>
@{
    ViewData["Title"] = "Соискатели";
    var filter = (ApplicantFilterParams)ViewBag.Filter!;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="search" name="Search" value="@filter.Search" class="form-control" placeholder="ФИО" />
    </div>
    <div class="col-md-2">
        <select name="Education" class="form-select" asp-items="Html.GetEnumSelectList<EducationLevel>()">
            <option value="">Образование</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="number" name="SalaryFrom" value="@filter.SalaryFrom" class="form-control" placeholder="Зарплата от" step="0.01" />
    </div>
    <div class="col-md-2">
        <input type="number" name="SalaryTo" value="@filter.SalaryTo" class="form-control" placeholder="Зарплата до" step="0.01" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Найти</button>
        <a asp-action="Index" asp-route-reset="1" class="btn btn-outline-secondary">Сброс</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Образование</th>
            <th>Опыт</th>
            <th>Зарплата</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@Html.DisplayFor(_ => item.Education)</td>
            <td>@item.ExperienceYears</td>
            <td>@item.DesiredSalary.ToString("N2")</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                <a asp-action="MatchVacancies" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Подбор</a>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-primary">Изменить</a>
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="text-muted">Всего: @Model.TotalCount</p>
@await Html.PartialAsync("_Pager", Model)
