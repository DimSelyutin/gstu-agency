@model PagedListViewModel<Interview>
@{
    ViewData["Title"] = "Собеседования";
    var filter = (InterviewFilterParams)ViewBag.Filter!;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="date" name="DateFrom" value="@filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="DateTo" value="@filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <select name="ApplicantId" asp-items="ViewBag.ApplicantId" class="form-select">
            <option value="">Соискатель</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="VacancyId" asp-items="ViewBag.VacancyId" class="form-select">
            <option value="">Вакансия</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="Result" class="form-select" asp-items="Html.GetEnumSelectList<InterviewResult>()">
            <option value="">Результат</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="search" name="Search" value="@filter.Search" class="form-control" placeholder="Поиск" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Найти</button>
        <a asp-action="Index" asp-route-reset="1" class="btn btn-outline-secondary">Сброс</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Соискатель</th>
            <th>Вакансия</th>
            <th>Результат</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Date.ToString("dd.MM.yyyy")</td>
            <td>@item.Applicant?.FullName</td>
            <td>@item.Vacancy?.Title</td>
            <td>@Html.DisplayFor(_ => item.Result)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-primary">Изменить</a>
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="text-muted">Всего: @Model.TotalCount</p>
@await Html.PartialAsync("_Pager", Model)
