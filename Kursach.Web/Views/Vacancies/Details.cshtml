@model Vacancy
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Company)</dt>
    <dd class="col-sm-9">@Model.Company?.Name (@Model.Company?.Industry?.Name)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Salary)</dt>
    <dd class="col-sm-9">@Model.Salary.ToString("N2")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ClosedDate)</dt>
    <dd class="col-sm-9">@(Model.ClosedDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
</dl>

<h2 class="h5">Требуемые навыки</h2>
@if (Model.VacancySkills.Any())
{
    <ul>
        @foreach (var vs in Model.VacancySkills.OrderBy(s => s.Skill?.Name))
        {
            <li>@(vs.Skill?.Name ?? vs.SkillId.ToString()) — мин. @vs.MinLevel</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Не указаны.</p>
}

<div class="mt-3">
    @if (Model.Status == VacancyStatus.Open)
    {
        <a asp-action="Close" asp-route-id="@Model.Id" class="btn btn-warning">Закрыть вакансию</a>
    }
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
    <a asp-action="Index" class="btn btn-secondary">К списку</a>
</div>
