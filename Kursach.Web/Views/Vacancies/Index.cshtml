@model PagedListViewModel<Vacancy>
@{
    ViewData["Title"] = "Вакансии";
    var filter = (VacancyFilterParams)ViewBag.Filter!;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="search" name="Search" value="@filter.Search" class="form-control" placeholder="Должность" />
    </div>
    <div class="col-md-2">
        <select name="IndustryId" class="form-select" asp-items="ViewBag.IndustryId">
            <option value="">Сфера</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
            <option value="">Компания</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<VacancyStatus>()">
            <option value="">Статус</option>
        </select>
    </div>
    <div class="col-md-1">
        <input type="number" name="SalaryFrom" value="@filter.SalaryFrom" class="form-control" placeholder="Оклад от" />
    </div>
    <div class="col-md-1">
        <input type="number" name="SalaryTo" value="@filter.SalaryTo" class="form-control" placeholder="Оклад до" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Найти</button>
        <a asp-action="Index" asp-route-reset="1" class="btn btn-outline-secondary">Сброс</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Должность</th>
            <th>Компания</th>
            <th>Оклад</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Company?.Name</td>
            <td>@item.Salary.ToString("N2")</td>
            <td>@Html.DisplayFor(_ => item.Status)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                @if (item.Status == VacancyStatus.Open)
                {
                    <a asp-action="Close" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Закрыть</a>
                }
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-primary">Изменить</a>
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="text-muted">Всего: @Model.TotalCount</p>
@await Html.PartialAsync("_Pager", Model)
